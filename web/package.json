{
  "name": "signo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:build": "node server/buildApi.ts",
    "api:build:real": "node server/buildApi.ts --source=files",
    "dev": "npm run api:build && vite",
    "dev:real": "npm run api:build:real && vite",
    "build": "npm run api:build && npm run check:layers && npm test && tsc -b && vite build",
    "build:real": "npm run api:build:real && npm run check:layers && npm test && tsc -b && vite build",
    "test": "node --test server/validate.test.ts server/summary.test.ts server/periods.test.ts server/cover.test.ts server/annual.test.ts server/trends.test.ts server/cellBundle.test.ts",
    "check:layers": "node scripts/checkLayers.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "22.x"
  }
}
